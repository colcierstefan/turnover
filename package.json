{
  "name": "turnover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @turnover/web dev",
    "build": "pnpm --filter @turnover/web build",
    "start": "pnpm --filter @turnover/web start",
    "lint": "eslint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "db:migrate:create": "pnpm --filter @turnover/db db:migrate:create",
    "db:migrate": "pnpm --filter @turnover/db db:migrate",
    "check:vertex": "pnpm --filter @turnover/core check:vertex",
    "evals:label-extraction": "pnpm --filter @turnover/core evals:label-extraction",
    "evals:invoice-extraction": "pnpm --filter @turnover/core evals:invoice-extraction",
    "evals:report-triage": "pnpm --filter @turnover/core evals:report-triage",
    "evals:self-help-tips": "pnpm --filter @turnover/core evals:self-help-tips",
    "evals:issue-diagnosis": "pnpm --filter @turnover/core evals:issue-diagnosis"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.1"
}
