{
  "name": "turnover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "check:vertex": "tsx --env-file=.env --conditions=react-server scripts/check-vertex.ts",
    "evals:label-extractor": "tsx --env-file=.env --conditions=react-server src/agents/label-extractor/evals/label-extractor-agent.eval.ts",
    "evals:invoice-extractor": "tsx --env-file=.env --conditions=react-server src/agents/invoice-extractor/evals/invoice-extractor-agent.eval.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.33.0",
    "@google-cloud/storage": "8.4.0",
    "@google/genai": "3.6.1",
    "@langfuse/client": "6.1.1",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dejavu-fonts-ttf": "2.37.3",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdfkit": "0.20.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@10.12.1"
}
