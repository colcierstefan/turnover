{
  "name": "@turnover/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/generated/prisma/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "typescript": "^5"
  }
}
