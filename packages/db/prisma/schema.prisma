generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserLanguage {
  EN
  RO
}

model User {
  id              String       @id @default(uuid())
  auth0Id         String       @unique
  email           String
  name            String?
  language        UserLanguage?
  createdAt       DateTime     @default(now())
  membership      Membership?
  sentInvitations Invitation[]
}

model Organization {
  id          String       @id @default(uuid())
  name         String
  contactPhone String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  invitations Invitation[]
  units       Unit[]
  handymen    Handyman[]
}

enum MembershipRole {
  OWNER
  MANAGER
}

model Membership {
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole
  createdAt      DateTime       @default(now())

  @@id([organizationId, userId])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  invitedById    String
  invitedBy      User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model Unit {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  address              String
  reportToken          String       @unique
  reportTokenRotatedAt DateTime?
  createdAt            DateTime     @default(now())
  appliances           Appliance[]
  documents            Document[]
  issues               Issue[]

  @@index([organizationId])
}

enum ApplianceCategory {
  FRIDGE
  FREEZER
  OVEN
  HOB
  MICROWAVE
  DISHWASHER
  WASHING_MACHINE
  DRYER
  WASHER_DRYER
  AIR_CONDITIONER
  WATER_HEATER
  EXTRACTOR_HOOD
  TV
  COFFEE_MACHINE
  OTHER
}

model Appliance {
  id               String              @id @default(uuid())
  unitId           String
  unit             Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  category         ApplianceCategory
  brand            String?
  model            String?
  serialNumber     String?
  // Partial ISO date as printed on the label: "2019", "2019-06" or "2019-06-14".
  manufactureDate  String?
  purchaseDate     DateTime?           @db.Date
  purchasePriceRon Decimal?            @db.Decimal(10, 2)
  warrantyUntil    DateTime?           @db.Date
  notes            String?
  createdAt        DateTime            @default(now())
  documents        ApplianceDocument[]
  issues           Issue[]

  @@index([unitId])
}

enum DocumentKind {
  LABEL_PHOTO
  INVOICE
  PHOTO
}

model Document {
  id            String              @id @default(uuid())
  unitId        String
  unit          Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  storagePath   String
  contentType   String
  extractedData Json?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  appliances    ApplianceDocument[]

  @@index([unitId])
}

model ApplianceDocument {
  applianceId String
  appliance   Appliance @relation(fields: [applianceId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([applianceId, documentId])
  @@index([documentId])
}

enum IssueStatus {
  NEW
  DIAGNOSED
  CONTACTED
  SCHEDULED
  RESOLVED
}

enum IssueCategory {
  SELF_FIX
  PART
  REPAIR
  REPLACE
}

enum ReporterRole {
  GUEST
  CLEANER
  MANAGER
}

enum ReporterLanguage {
  EN
  RO
}

enum EmergencyType {
  GAS_SMELL
  WATER_LEAK
  ELECTRICAL_BURNING
}

model Issue {
  id                 String           @id @default(uuid())
  unitId             String
  unit               Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  applianceId        String?
  appliance          Appliance?       @relation(fields: [applianceId], references: [id], onDelete: SetNull)
  reporterRole       ReporterRole
  reporterName       String?
  reporterLanguage   ReporterLanguage
  description        String
  status             IssueStatus      @default(NEW)
  category           IssueCategory?
  diagnosis          Json?
  isEmergency        Boolean          @default(false)
  emergencyType      EmergencyType?
  selfHelpTips       Json?
  resolvedByReporter Boolean          @default(false)
  costRon            Decimal?         @db.Decimal(10, 2)
  costNote           String?
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())
  photos             IssuePhoto[]
  followUps          IssueFollowUp[]
  handymanMessages   HandymanMessage[]

  @@index([unitId, createdAt])
  @@index([applianceId])
}

model IssuePhoto {
  id          String   @id @default(uuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  storagePath String
  contentType String
  createdAt   DateTime @default(now())

  @@index([issueId])
}

model IssueFollowUp {
  id        String   @id @default(uuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  question  String
  answer    String?
  createdAt DateTime @default(now())

  @@index([issueId])
}

enum HandymanTrade {
  PLUMBER
  ELECTRICIAN
  APPLIANCE_TECHNICIAN
  AC_TECHNICIAN
  LOCKSMITH
  GENERAL_HANDYMAN
}

model Handyman {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // E.164, e.g. "+40712345678".
  phone          String
  trades         HandymanTrade[]
  notes          String?
  createdAt      DateTime          @default(now())
  messages       HandymanMessage[]

  @@unique([organizationId, phone])
}

model HandymanMessage {
  id                 String    @id @default(uuid())
  issueId            String
  issue              Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  handymanId         String?
  handyman           Handyman? @relation(fields: [handymanId], references: [id], onDelete: SetNull)
  recipientName      String?
  // Both recipient fields empty: the manager chose the chat in WhatsApp.
  recipientPhone     String?
  textRo             String
  textEn             String?
  openedInWhatsAppAt DateTime
  createdAt          DateTime  @default(now())

  @@index([issueId])
  @@index([handymanId])
}
