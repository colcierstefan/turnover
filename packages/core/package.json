{
  "name": "@turnover/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check:vertex": "tsx --env-file=../../.env --conditions=react-server scripts/check-vertex.ts",
    "evals:label-extraction": "tsx --env-file=../../.env --conditions=react-server src/appliance/evals/label-extraction.eval.ts",
    "evals:invoice-extraction": "tsx --env-file=../../.env --conditions=react-server src/appliance/evals/invoice-extraction.eval.ts",
    "evals:report-triage": "tsx --env-file=../../.env --conditions=react-server src/issue/evals/report-triage.eval.ts",
    "evals:self-help-tips": "tsx --env-file=../../.env --conditions=react-server src/issue/evals/self-help-tips.eval.ts",
    "evals:issue-diagnosis": "tsx --env-file=../../.env --conditions=react-server src/issue/evals/issue-diagnosis.eval.ts",
    "evals:handyman-message-draft": "tsx --env-file=../../.env --conditions=react-server src/handyman/evals/handyman-message-draft.eval.ts",
    "evals:handyman-message-translation": "tsx --env-file=../../.env --conditions=react-server src/handyman/evals/handyman-message-translation.eval.ts",
    "evals:issue-summary": "tsx --env-file=../../.env --conditions=react-server src/issue/evals/issue-summary.eval.ts",
    "evals:issue-chat": "tsx --env-file=../../.env --conditions=react-server src/agents/issue-chat/evals/issue-chat.eval.ts"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "5.0.144",
    "@ai-sdk/otel": "1.0.179",
    "@auth0/nextjs-auth0": "4.33.0",
    "@google-cloud/storage": "8.4.0",
    "@langfuse/client": "6.1.1",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@mastra/ai-sdk": "1.12.1",
    "@mastra/core": "1.86.0",
    "@mastra/observability": "1.24.3",
    "@mastra/otel-bridge": "1.6.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@prisma/adapter-pg": "7.10.1",
    "@turnover/db": "workspace:*",
    "ai": "7.0.179",
    "libphonenumber-js": "1.13.17",
    "pino": "10.4.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "0.17.7",
    "dejavu-fonts-ttf": "2.37.3",
    "next": "16.4.6",
    "pdfkit": "0.20.2",
    "pino-pretty": "13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  }
}
