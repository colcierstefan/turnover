{
  "name": "@turnover/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check:vertex": "tsx --env-file=../../.env --conditions=react-server scripts/check-vertex.ts",
    "evals:label-extractor": "tsx --env-file=../../.env --conditions=react-server src/appliance/label-extractor/evals/label-extractor-agent.eval.ts",
    "evals:invoice-extractor": "tsx --env-file=../../.env --conditions=react-server src/appliance/invoice-extractor/evals/invoice-extractor-agent.eval.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.33.0",
    "@google-cloud/storage": "8.4.0",
    "@google/genai": "3.6.1",
    "@langfuse/client": "6.1.1",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@prisma/adapter-pg": "7.10.1",
    "@turnover/db": "workspace:*",
    "pino": "10.4.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "0.17.7",
    "dejavu-fonts-ttf": "2.37.3",
    "next": "16.4.6",
    "pdfkit": "0.20.2",
    "pino-pretty": "13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  }
}
